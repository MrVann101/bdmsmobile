.artifacts/

# Server / Node.js
**/node_modules/
node_modules/
server/node_modules/

# Secrets & Environment variables (NEVER COMMIT SECRETS)
.env
.env.*
*.env
server/.env
server/.env.*
!**/.env.example

# Uploads & Temporary Media (preserve directory structure via .gitkeep)
server/uploads/*
!server/uploads/**/.gitkeep
!server/uploads/.gitkeep

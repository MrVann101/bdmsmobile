<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="40dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageButton
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Go back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DUTY #02" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/statusCompletedText" android:background="@color/statusCompletedBg" android:paddingHorizontal="6dp" android:paddingVertical="1dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" BDMS OPS" android:textSize="10sp" android:textColor="@color/colorTextSecondary" android:layout_marginStart="6dp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S11 — Notification Center" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/colorTextPrimary"/>
            </LinearLayout>

            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_manage" app:tint="@color/colorTextPrimary" android:contentDescription="Filter" android:background="?attr/selectableItemBackgroundBorderless" android:padding="4dp" android:layout_marginEnd="4dp"/>
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_agenda" app:tint="@color/statusRejectedText" android:contentDescription="Alerts" android:background="?attr/selectableItemBackgroundBorderless" android:padding="4dp"/>
        </LinearLayout>

        <!-- Operations Activity Log Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/colorBackground"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BARANGAY OPERATIONS ACTIVITY LOG" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/colorPrimary"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Officer J. Mendoza • Desk #02 (Admin..." android:textSize="11sp" android:textColor="@color/colorTextSecondary"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● LIVE FEED" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/statusCompletedText" android:background="@color/statusCompletedBg" android:paddingHorizontal="8dp" android:paddingVertical="3dp"/>
        </LinearLayout>

        <!-- Unread Stat Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/statusRejectedBg"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_menu_report_image" app:tint="@color/statusRejectedText" android:contentDescription="SOS" android:layout_marginEnd="10dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="14 Unread (3 Critical SOS)" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/statusRejectedText"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="All 7 Puroks active - Gateway 9..." android:textSize="11sp" android:textColor="@color/colorTextSecondary"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Alert Rules"
                android:textSize="11sp"
                android:textColor="@color/colorTextPrimary"
                app:backgroundTint="@color/colorSurface"
                app:cornerRadius="6dp" />
        </LinearLayout>

        <!-- Filter Pills Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="All (28)" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/white" android:background="@drawable/badge_background" android:backgroundTint="@color/colorPrimary" android:paddingHorizontal="14dp" android:paddingVertical="8dp" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● Emergencies (3)" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/statusRejectedText" android:background="@color/statusRejectedBg" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📋 Documents (9)" android:textSize="12sp" android:textColor="@color/colorTextSecondary" android:background="@drawable/badge_background" android:backgroundTint="@color/colorBackground" android:paddingHorizontal="12dp" android:paddingVertical="8dp"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Section Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PRIORITY LIFE SAFETY &amp; BDRRMC DISPATCH" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/statusRejectedText"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3 Pending Actions" android:textSize="11sp" android:textColor="@color/colorTextSecondary"/>
        </LinearLayout>

        <!-- Notification Card 1: BDRRMC Rescue Dispatch Confirmed -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorSurface"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/statusRejectedText"
            app:strokeWidth="1.5dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EMERG-044" android:fontFamily="monospace" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/statusRejectedText" android:background="@color/statusRejectedBg" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:layout_marginEnd="6dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ch 2" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/colorPrimary" android:background="@color/colorPrimaryLight" android:paddingHorizontal="6dp" android:paddingVertical="2dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5m ago"
                        android:textSize="11sp"
                        android:textColor="@color/colorTextSecondary" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BDRRMC Rescue Dispatch Confirmed"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Purok 3 Riverside • Flash Flood Trapping"
                    android:textSize="11sp"
                    android:textColor="@color/colorTextSecondary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Team Alpha deployed with Rescue Boat 01 to Elena Ramos residence (4 trapped, 1 bedridden senior). ETA approx. 4 minutes."
                    android:textSize="12sp"
                    android:textColor="@color/colorTextSecondary"
                    android:layout_marginBottom="12dp" />

                <!-- Map Thumbnail Preview -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:orientation="horizontal"
                    android:background="@color/colorBackground"
                    android:padding="8dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_mapmode" app:tint="@color/colorPrimary" android:contentDescription="Map" android:layout_marginEnd="10dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Boat 01 Bearing 142° SE" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/colorTextPrimary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Speed: 8 knots" android:textSize="11sp" android:textColor="@color/colorPrimary"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="View Dispatch (S7)"
                        android:textSize="11sp"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/statusRejectedText"
                        app:cornerRadius="6dp"
                        android:layout_marginEnd="4dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="🗺 Map"
                        android:textSize="11sp"
                        android:textColor="@color/colorTextPrimary"
                        app:backgroundTint="@color/colorBackground"
                        app:cornerRadius="6dp"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Compose Public Advisory Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnComposeAdvisory"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="📢 Compose Public Advisory / SMS Blast"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:backgroundTint="@color/statusCompletedText"
            app:cornerRadius="8dp"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>

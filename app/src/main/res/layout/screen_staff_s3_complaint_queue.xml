<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface">

    <!-- Fixed Header Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        app:elevation="2dp">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BDMS BACK-OFFICE" android:textSize="11sp" android:textColor="@color/colorPrimary" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" STAFF" android:textSize="9sp" android:textStyle="bold" android:textColor="@color/statusCompletedText" android:background="@color/statusCompletedBg" android:paddingHorizontal="6dp" android:paddingVertical="1dp" android:layout_marginStart="6dp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dashboard" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/colorTextPrimary"/>
                </LinearLayout>

                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_search" app:tint="@color/colorTextPrimary" android:contentDescription="Search" android:background="?attr/selectableItemBackgroundBorderless" android:padding="8dp"/>
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_agenda" app:tint="@color/statusRejectedText" android:contentDescription="Alerts" android:background="?attr/selectableItemBackgroundBorderless" android:padding="8dp" android:layout_marginStart="4dp"/>
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="90dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title & Overdue Pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Docket &amp; Complaints" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/colorTextPrimary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● 2 Overdue" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/statusRejectedText" android:background="@color/statusRejectedBg" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:layout_marginStart="8dp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙ Filter" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/colorPrimary" android:background="@color/colorPrimaryLight" android:paddingHorizontal="10dp" android:paddingVertical="6dp"/>
            </LinearLayout>

            <!-- Search Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@drawable/badge_background"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="8dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_search" app:tint="@color/colorTextSecondary" android:contentDescription="Search" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Search docket #, complainant, purok..." android:textSize="13sp" android:textColor="@color/colorTextSecondary"/>
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_help" app:tint="@color/colorTextSecondary" android:contentDescription="Voice"/>
            </LinearLayout>

            <!-- SLA Priority View Indicator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Priority View: SLA Breach First" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/statusRejectedText"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6 Total Enqueued" android:textSize="11sp" android:textColor="@color/colorTextSecondary"/>
            </LinearLayout>

            <!-- Filter Pills Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="All Cases (6)" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/white" android:background="@drawable/badge_background" android:backgroundTint="@color/colorPrimary" android:paddingHorizontal="14dp" android:paddingVertical="8dp" android:layout_marginEnd="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● Overdue (2)" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/statusRejectedText" android:background="@color/statusRejectedBg" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:layout_marginEnd="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mediation (3)" android:textSize="12sp" android:textColor="@color/colorTextSecondary" android:background="@drawable/badge_background" android:backgroundTint="@color/colorBackground" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:layout_marginEnd="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hearing Set (1)" android:textSize="12sp" android:textColor="@color/colorTextSecondary" android:background="@drawable/badge_background" android:backgroundTint="@color/colorBackground" android:paddingHorizontal="12dp" android:paddingVertical="8dp"/>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Complaints Card Stack -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Card 1: Overdue #1 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/statusRejectedText"
                    app:strokeWidth="1.5dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CASE-2024-089" android:fontFamily="monospace" android:textSize="11sp" android:textColor="@color/colorTextSecondary"/>
                                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sanitation • Illegal Dumping" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/colorTextPrimary" android:background="@color/colorBackground" android:paddingHorizontal="8dp" android:paddingVertical="2dp" android:layout_marginEnd="6dp"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Purok 2" android:textSize="11sp" android:textColor="@color/colorTextSecondary" android:background="@color/colorBackground" android:paddingHorizontal="6dp" android:paddingVertical="2dp"/>
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚠️ OVERDUE • 48h"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="@color/statusRejectedText"
                                android:background="@color/statusRejectedBg"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Continuous illegal dumping near creek spillway"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Piles of municipal garbage and debris left nightly, threatening drainage overflow before expected rains."
                            android:textSize="12sp"
                            android:textColor="@color/colorTextSecondary"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@color/colorBackground"
                            android:padding="10dp"
                            android:layout_marginBottom="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Complainant: Elena Ramos" android:textSize="11sp" android:textColor="@color/colorTextSecondary"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Respondent: Unidentified Tricycle Operators" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/statusRejectedText" android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="⏳ Day 5 • Awaiting Tanod Assignment"
                                android:textSize="11sp"
                                android:textColor="@color/statusRejectedText"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="Assign Officer"
                                android:textSize="11sp"
                                android:textColor="@color/white"
                                app:backgroundTint="@color/colorPrimary"
                                app:cornerRadius="6dp"
                                android:layout_marginEnd="6dp" />

                            <com.google.android.material.button.MaterialButton
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:text="⋯"
                                android:textColor="@color/colorTextPrimary"
                                app:backgroundTint="@color/colorBackground"
                                app:cornerRadius="6dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2: Overdue #2 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/statusRejectedText"
                    app:strokeWidth="1.5dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CASE-2024-082" android:fontFamily="monospace" android:textSize="11sp" android:textColor="@color/colorTextSecondary"/>
                                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Noise Disturbance" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/colorTextPrimary" android:background="@color/colorBackground" android:paddingHorizontal="8dp" android:paddingVertical="2dp" android:layout_marginEnd="6dp"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Purok 5" android:textSize="11sp" android:textColor="@color/colorTextSecondary" android:background="@color/colorBackground" android:paddingHorizontal="6dp" android:paddingVertical="2dp"/>
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚠️ OVERDUE • Day 3"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="@color/statusRejectedText"
                                android:background="@color/statusRejectedBg"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Late-night commercial videoke exceeding 10 PM curfew"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Repeated resident distress; sound system operated past midnight directly adjacent to senior residences."
                            android:textSize="12sp"
                            android:textColor="@color/colorTextSecondary"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@color/colorBackground"
                            android:padding="10dp"
                            android:layout_marginBottom="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Complainant: Rodolfo Cruz" android:textSize="11sp" android:textColor="@color/colorTextSecondary"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Respondent: Aling Tess Resto-Bar" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/colorTextPrimary" android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="⏳ 1st Citation Unacknowledged"
                                android:textSize="11sp"
                                android:textColor="@color/statusRejectedText"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="Issue 2nd Notice"
                                android:textSize="11sp"
                                android:textColor="@color/colorTextPrimary"
                                app:backgroundTint="@color/colorBackground"
                                app:cornerRadius="6dp"
                                android:layout_marginEnd="6dp" />

                            <com.google.android.material.button.MaterialButton
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="Escalate"
                                android:textSize="11sp"
                                android:textColor="@color/statusRejectedText"
                                app:backgroundTint="@color/statusRejectedBg"
                                app:cornerRadius="6dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar (5 Tabs for Staff) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@color/colorSurface"
        android:orientation="horizontal"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_menu_myplaces" app:tint="@color/colorTextSecondary" android:contentDescription="Dashboard"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dashboard" android:textSize="9sp" android:textColor="@color/colorTextSecondary"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_menu_edit" app:tint="@color/colorPrimary" android:contentDescription="Complaints"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Complaints" android:textSize="9sp" android:textStyle="bold" android:textColor="@color/colorPrimary"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_menu_report_image" app:tint="@color/colorTextSecondary" android:contentDescription="Emergency"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Emergency" android:textSize="9sp" android:textColor="@color/colorTextSecondary"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_menu_send" app:tint="@color/colorTextSecondary" android:contentDescription="Broadcasts"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Broadcasts" android:textSize="9sp" android:textColor="@color/colorTextSecondary"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_menu_manage" app:tint="@color/colorTextSecondary" android:contentDescription="More"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="More" android:textSize="9sp" android:textColor="@color/colorTextSecondary"/>
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

# ==========================================
# BDMS Mobile Backend Environment Variables
# ==========================================

# Port for the Express REST API server
PORT=5000

# PostgreSQL Connection String Format:
# postgresql://<username>:<password>@<host>:<port>/<database_name>
# Example: postgresql://postgres:mysecurepassword123@localhost:5432/bdms_db
DATABASE_URL=postgresql://postgres:YOUR_ACTUAL_PASSWORD@localhost:5432/bdms_db

# JWT Secret for authentication tokens (change in production)
JWT_SECRET=super_secret_jwt_key_change_in_production

# Resend Email API Key (optional for local dev)
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=noreply@barangaysanisidro.gov.ph
